# ==========================================
# LINUX SERVER ADMIN - CONFIGURAÇÕES
# ==========================================

# Porta externa onde o painel responderá no servidor (padrão: 8888)
PORT=8888

# Nome do servidor exibido no painel
SERVER_NAME="Meu Servidor Linux"

# Autenticação Web (Nginx HTTP Basic Auth)
# Protege o painel contra acessos não autorizados quando exposto à internet
WEB_USER="admin"
WEB_PASSWORD="admin"
# Defina DISABLE_AUTH="true" se estiver usando autenticação externa (ex: Authentik, Cloudflare Zero Trust)
DISABLE_AUTH="false"

# Chave de API Google Gemini (para o Agente Administrador IA)
# Obtenha gratuitamente em: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Notificações e Comandos via Telegram (Opcional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
